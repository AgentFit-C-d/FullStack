# Copy to .env.docker and replace the placeholders before starting the stack.
AGENTFIT_LOCAL_DB_PASSWORD=agentfit-local-only
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
AGENTFIT_HMAC_CURRENT_KEY_ID=replace-with-current-key-id
AGENTFIT_HMAC_CURRENT_SECRET=replace-with-long-random-hmac-secret

# Use deterministic for safe local regression, or solar for one real smoke call.
AGENTFIT_AI_V2_PROVIDER=deterministic
UPSTAGE_API_KEY=

# Optional previous key for rotation; set all three together when needed.
AGENTFIT_HMAC_PREVIOUS_KEY_ID=
AGENTFIT_HMAC_PREVIOUS_SECRET=
AGENTFIT_HMAC_PREVIOUS_VALID_UNTIL=
