# Copy this file to .env and replace every placeholder. Never commit .env.
AGENTFIT_DB_USERNAME=postgres
AGENTFIT_DB_PASSWORD=change-me
AGENTFIT_DB_URL=jdbc:postgresql://localhost:5432/agentfit
AGENTFIT_HMAC_CURRENT_KEY_ID=local-current
AGENTFIT_HMAC_CURRENT_SECRET=replace-with-a-long-random-secret
AGENTFIT_AI_SERVICE_TOKEN=replace-with-an-internal-service-token
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
AGENTFIT_GITHUB_REDIRECT_URI=http://localhost:8080/api/login/oauth2/code/github

# Add the real Upstage key to .env. Keep .env local and never commit it.
# UPSTAGE_API_KEY=replace-with-upstage-api-key
